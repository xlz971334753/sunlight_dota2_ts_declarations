{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "run-p build:*",
    "build:tsc": "tsc -b packages",
    "build:types": "ts-node-script build",
    "changelog:types": "ts-node scripts/diff-types.ts",
    "check-generated": "node scripts/check-generated.js",
    "update:resources": "node scripts/update-resources.js",
    "test:resources": "node --test scripts/resources/resources.test.js",
    "check:modifiers": "node scripts/modifier-functions/check.js",
    "test:modifiers": "node --test scripts/modifier-functions/*.test.js",
    "dev": "run-p dev:*",
    "dev:tsc": "tsc -b packages --watch",
    "dev:types": "nodemon",
    "lint": "run-s lint:*",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:modifiers": "eslint --no-ignore scripts/modifier-functions/*.js",
    "prepublishOnly": "npm run build",
    "publish:types": "ts-node scripts/publish-types.ts",
    "test": "tsc -b test",
    "bump:lua-types": "ts-node scripts/bump-version.ts packages/dota-lua-types",
    "bump:panorama-types": "ts-node scripts/bump-version.ts packages/panorama-types"
  },
  "prettier": {
    "printWidth": 100,
    "proseWrap": "always",
    "singleQuote": true,
    "trailingComma": "all",
    "overrides": [
      {
        "files": "packages/*/types/**/*",
        "options": {
          "printWidth": 120
        }
      }
    ]
  },
  "devDependencies": {
    "@ark120202/eslint-config": "^2.5.0",
    "@moddota/dota-data": "^0.47.2",
    "@types/fs-extra": "^9.0.4",
    "@types/lodash": "^4.14.165",
    "@types/node": "^20.14.8",
    "@types/prettier": "^2.1.5",
    "@types/wordwrap": "^1.0.0",
    "dts-dom": "3.6.0",
    "eslint": "^7.13.0",
    "fs-extra": "^9.0.1",
    "lodash": "^4.17.20",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.1.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.2",
    "wordwrap": "^1.0.0"
  },
  "version": "0.1.0",
  "name": "sunlight_dota2_ts_declarations"
}
